<!-- Bootstrap CSS -->
<link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css" rel="stylesheet">
<!-- Bootstrap JS -->
<script src="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/js/bootstrap.bundle.min.js"></script>



<!DOCTYPE html>
<html>
  <head>
  <%= stylesheet_link_tag "custom", media: "all", "data-turbo-track": "reload" %>

    <%= yield :page_specific_styles %>
    <title><%= content_for(:title) || "Guruharu" %></title>
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <meta name="apple-mobile-web-app-capable" content="yes">
    <meta name="mobile-web-app-capable" content="yes">
    <%= csrf_meta_tags %>
    <%= csp_meta_tag %>

    <%= yield :head %>

    <link rel="icon" href="/icon.png" type="image/png">
    <link rel="icon" href="/icon.svg" type="image/svg+xml">
    <link rel="apple-touch-icon" href="/icon.png">

    <%= stylesheet_link_tag :app, "data-turbo-track": "reload" %>
    <%= javascript_importmap_tags %>
  </head>

  <body>
    <!-- ▼ ナビゲーションヘッダー -->
    <nav class="navbar custom-navbar  navbar-expand-lg navbar-dark shadow-sm">
      <div class="container">
        <!-- アプリ名リンク -->
        <%= link_to "Guruharu", root_path, class: "navbar-brand gradient-text" %>

        <!-- 検索フォーム -->
        <% unless controller_name == "restaurants" && action_name == "search" %>
          <%= form_with url: restaurants_path, method: :get, local: true, class: "d-flex ms-auto" do %>
            <%= hidden_field_tag :lat, params[:lat].presence || session[:lat], id: "header-lat" %>
            <%= hidden_field_tag :lng, params[:lng].presence || session[:lng], id: "header-lng" %>

            <!-- 現在地取得ボタン -->
            <button type="button" id="header-get-location-btn" class="btn btn-outline-info me-2" title="現在地を取得">
            現在地を取得
            </button>

            <!-- 学校選択 -->
             <div class="me-2">
    <input id="school-input" class="form-control" list="school-list" placeholder="駅名、学校名を入力" autocomplete="off">
    <datalist id="school-list">
      <option value="坪内総合ビジネスカレッジ" data-lat="35.462464" data-lng="133.0651219">
      <option value="島根大学" data-lat="35.4848668" data-lng="133.0646449">
      <option value="島根県立大学 松江キャンパス" data-lat="35.4382825" data-lng="133.0575027">
      <option value="島根県立大学 浜田キャンパス" data-lat="34.883547" data-lng="132.0765442">
      <option value="松江西高等学校" data-lat="35.4478611" data-lng="133.0499432">
      <option value="松江工業高等専門学校" data-lat="35.4450255" data-lng="133.0728574">
      <option value="松江駅" data-lat="35.4584091" data-lng="133.0492003">
      <option value="東京駅" data-lat="35.6811398" data-lng="139.7644865">
    </datalist>
  </div>
                
            <!-- 検索範囲 -->
            <div class="me-2">
              <%= select_tag :range,
                options_for_select((1..5).map { |i| ["#{i}km", i] }, selected: params[:range] || session[:range] || 3),
                class: "form-select" %>
            </div>
                
            <!-- ジャンル -->
            <div class="me-2">
              <%= select_tag :genre,options_for_select([
                  ["指定なし", ""], 
                  ["和食","G004"],
                  ["洋食","G005"],
                  ["イタリアン・フレンチ","G006"],
                  ["中華","G007"],
                  ["韓国","G017"],
                  ["居酒屋", "G001"],
                  ["カフェ・スイーツ", "G014"],
                  ["ラーメン", "G013"],
                  ["焼肉","G008"]
                ], selected: params[:genre] || session[:genre]),
                class: "form-select" %>
            </div>
                
            <!-- 予算 -->
            <div class="me-2">
              <%= select_tag :budget_group,
                options_for_select([
                  ["指定なし", ""], ["～500円", "B009"], ["501〜1000円", "B010"],
                  ["1001〜1500円", "B011"], ["1501～2000円", "B001"], ["2000円～", "over_2000"]
                ], selected: params[:budget_group] || session[:budget_group]),
                class: "form-select" %>
            </div>
                
            <!-- 営業中のみチェック -->
            <div class="form-check form-check-inline me-2 mt-2">
              <%= check_box_tag :open, "1", (params[:open] || session[:open]) == "1", id: "header-open", class: "form-check-input" %>
              <label class="form-check-label" for="header-open">営業中</label>
            </div>
                
            <%= submit_tag "検索", class: "btn btn-search" %>
          <% end %>


        <% end %>
      </div>
    </nav>
    <!-- ▲ ナビゲーションヘッダー -->

    <!-- ▼ メインコンテンツ -->
    <div class="container mt-4">
      <%= yield %>
    </div>
    <!-- ▲ メインコンテンツ -->
    <script>
      document.addEventListener("DOMContentLoaded", () => {
        const geoBtn = document.getElementById("header-get-location-btn");
        const latField = document.getElementById("header-lat");
        const lngField = document.getElementById("header-lng");
        const schoolInput = document.getElementById("school-input");
        const schoolList = document.getElementById("school-list");

        // ▼ 現在地取得ボタン
        geoBtn?.addEventListener("click", () => {
          if (!navigator.geolocation) {
            alert("このブラウザでは位置情報がサポートされていません");
            return;
          }

          geoBtn.disabled = true;
          geoBtn.textContent = "取得中...";

          navigator.geolocation.getCurrentPosition(
            (position) => {
              latField.value = position.coords.latitude;
              lngField.value = position.coords.longitude;

              // 入力欄にも反映
              schoolInput.value = "現在地";

              // UIフィードバック
              geoBtn.textContent = "取得済み";
              geoBtn.disabled = false;
            },
            (error) => {
              alert("位置情報を取得できませんでした: " + error.message);
              geoBtn.textContent = "再取得";
              geoBtn.disabled = false;
               }
          );
        });

        // ▼ 学校名選択で緯度・経度を反映
        schoolInput?.addEventListener("input", () => {
          const inputValue = schoolInput.value;
          const options = schoolList.options;

          for (let i = 0; i < options.length; i++) {
            if (options[i].value === inputValue) {
              const lat = options[i].dataset.lat || "";
              const lng = options[i].dataset.lng || "";

              latField.value = lat;
              lngField.value = lng;
              return;
            }
          }
        
          // 該当なしの場合、緯度経度をクリア
          latField.value = "";
          lngField.value = "";
        });
      });
    </script>
  </body>
</html>

