<!-- app/views/restaurants/index.html.erb -->
<%= stylesheet_link_tag "restaurants_index", :media => "all" %>


<div class="container mt-4">
  <h1 class="mb-4">検索結果 <%= @shops.size %> 件</h1>

  <% if @shops.present? %>
    <% @shops.each do |shop| %>
      <div class="card mb-3 shadow-sm overflow-hidden"  style="height: 300px;">
        <div class="row g-0 h-100">
          <% if shop["photo"] && shop["photo"]["pc"] && shop["photo"]["pc"]["l"].present? %>
            <div class="col-md-4">
              <%= image_tag shop["photo"]["pc"]["l"].gsub(/^http:/, "https:"),alt: "店舗画像",class: "h-100", style:  "width: 300px; object-fit: cover; object-position: center;" %>
            </div>
          <% end %>
          <div class="col d-flex align-items-center">
            <div class="card-body py-3">
              <h5 class="card-title mb-2"><%= shop["name"] %></h5>
              <p class="card-text mb-1"><strong>住所:</strong> <%= shop["address"] %></p>
              <p class="card-text mb-1"><strong>アクセス:</strong> <%= shop["access"] %></p>
              <%= link_to "詳細を見る", restaurant_path(shop["id"],page: @page), class: "btn btn-outline-primary btn-sm mt-2 detail-button" %>
            </div>
          </div>
        </div>
      </div>
    <% end %>
  <% else %>
    <div class="alert alert-warning mt-4">検索結果がありません。</div>
  <% end %>

  <div class="mt-4 d-flex justify-content-center">
    <% if @total_pages > 1 %>
      <nav aria-label="ページネーション" class="mt-4">
        <ul class="pagination justify-content-center">

          <%# Prev ボタン %>
          <% if @page > 1 %>
            <li class="page-item">
              <%= link_to "&laquo; Prev".html_safe, restaurants_path(lat: @latitude, lng: @longitude, range: @range, page: @page - 1), class: "page-link" %>
            </li>
          <% end %>

          <%# ページ番号リンク %>
          <% start_page = [@page - 2, 1].max %>
          <% end_page = [@page + 2, @total_pages].min %>

          <% if start_page > 1 %>
            <li class="page-item"><%= link_to "1", restaurants_path(lat: @latitude, lng: @longitude, range: @range, page: 1), class: "page-link" %></li>
            <% if start_page > 2 %>
              <li class="page-item disabled"><span class="page-link">...</span></li>
            <% end %>
          <% end %>

          <% (start_page..end_page).each do |i| %>
            <li class="page-item <%= 'active' if i == @page %>">
              <%= link_to i, restaurants_path(lat: @latitude, lng: @longitude, range: @range, page: i), class: "page-link" %>
            </li>
          <% end %>
          
          <% if end_page < @total_pages %>
            <% if end_page < @total_pages - 1 %>
              <li class="page-item disabled"><span class="page-link">...</span></li>
            <% end %>
            <li class="page-item"><%= link_to @total_pages, restaurants_path(lat: @latitude, lng: @longitude, range: @range, page: @total_pages), class: "page-link" %></li>
          <% end %>
          
          <%# Next ボタン %>
          <% if @page < @total_pages %>
            <li class="page-item">
              <%= link_to "Next &raquo;".html_safe, restaurants_path(lat: @latitude, lng: @longitude, range: @range, page: @page + 1), class: "page-link" %>
            </li>
          <% end %>
          
        </ul>
      </nav>
    <% end %>
  </div>

  <div class="mt-3">
    <%= link_to "検索ページへ", search_restaurants_path, class: "btn btn custom-gradient",style: "color: white;background: #ff9721;background: linear-gradient(90deg,rgba(255, 151, 33, 1) 1%, rgba(255, 123, 28, 1) 100%);" %>
  </div>

</div>
